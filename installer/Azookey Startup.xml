<?xml version="1.0"?>
<Task version="1.4" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2025-03-28T20:02:06</Date>
    <Author>fkunn1326</Author>
    <URI>\Azookey Startup</URI>
  </RegistrationInfo>
  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
    </LogonTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <!-- Users, not Administrators: the install is machine-wide, so the
           logon trigger must fire for every user. HighestAvailable still
           elevates members of Administrators (UIAccess needs it) and is a
           no-op for standard users. -->
      <GroupId>S-1-5-32-545</GroupId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <!-- the launcher supervises the whole IME stack; stopping it on
         battery would kill the IME the moment a laptop is unplugged -->
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <!-- true: a logon trigger the scheduler misses (it was busy, or the
         session was still coming up) is otherwise never retried, so the whole
         IME stack never starts and the only symptom is that nothing converts
         (issue #79). StartWhenAvailable runs the missed trigger as soon as it
         can. Safe to retry: the launcher's single-instance mutex makes a
         second start a no-op.
         ASCII only in this file, like every comment above: the installer
         round-trips it through an Inno AnsiString (UpdateTaskXml), and the
         XML has no encoding declaration, so it must stay UTF-8-clean. -->
    <StartWhenAvailable>true</StartWhenAvailable>
    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>
    <IdleSettings>
      <StopOnIdleEnd>true</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
    <AllowStartOnDemand>true</AllowStartOnDemand>
    <Enabled>true</Enabled>
    <Hidden>false</Hidden>
    <RunOnlyIfIdle>false</RunOnlyIfIdle>
    <DisallowStartOnRemoteAppSession>false</DisallowStartOnRemoteAppSession>
    <UseUnifiedSchedulingEngine>true</UseUnifiedSchedulingEngine>
    <WakeToRun>false</WakeToRun>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- quoted: the path contains a space (Program Files) and wscript
           does no prefix guessing -->
      <Command>wscript.exe</Command>
      <Arguments>"PATH_TO_VBS"</Arguments>
    </Exec>
  </Actions>
</Task>